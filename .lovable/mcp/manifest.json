{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://bsuvywszdkqaetbyrfqk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "remix-of-welcome-home",
      "version": "0.1.0",
      "title": "Remix of Welcome Home"
    },
    "tools": [
      {
        "name": "academy_overview",
        "title": "Academy overview",
        "description": "Summary of the academy: student counts by status, group count, open leads and payment totals for a month.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "month": {
              "type": "string",
              "description": "Period month as YYYY-MM-01. Defaults to the current month."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_students",
        "title": "List students",
        "description": "List students in Akhmad Academy, optionally filtered by name or phone.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Filter by student first/last name or parent phone."
            },
            "limit": {
              "type": "integer",
              "description": "Max rows to return (default 25, max 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_groups",
        "title": "List groups",
        "description": "List study groups with schedule and monthly fee.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Filter by group name."
            },
            "limit": {
              "type": "integer",
              "description": "Max rows to return (default 50, max 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_payments",
        "title": "List payments",
        "description": "List recent payments with amount, method, status and period.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "student_id": {
              "type": "string",
              "description": "Filter to one student id."
            },
            "status": {
              "type": "string",
              "description": "Filter by payment status, e.g. paid or pending."
            },
            "limit": {
              "type": "integer",
              "description": "Max rows to return (default 25, max 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_leads",
        "title": "List leads",
        "description": "List sales leads (potential students) with status and source.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "Filter by lead status."
            },
            "limit": {
              "type": "integer",
              "description": "Max rows to return (default 25, max 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_lead",
        "title": "Create lead",
        "description": "Create a new lead (potential student enquiry) in the CRM.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Lead full name."
            },
            "phone": {
              "type": "string",
              "description": "Contact phone number."
            },
            "course": {
              "type": "string",
              "description": "Course the lead is interested in."
            },
            "source": {
              "type": "string",
              "description": "Where the lead came from, e.g. instagram, call."
            },
            "note": {
              "type": "string",
              "description": "Free-form note."
            }
          },
          "required": [
            "name",
            "phone"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
