# Required: copy the corresponding values from your existing .env file into Vercel.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required after Vercel creates your public domain.
APP_BASE_URL=https://your-project.vercel.app
# Play Market/Capacitor uchun ayni Vercel manzili.
CAPACITOR_SERVER_URL=https://your-project.vercel.app

# Optional integrations. Leave unset if you do not use the feature.
TELEGRAM_BOT_TOKEN=
# 16-256 random characters; Telegram permits only A-Z, a-z, 0-9, _ and -.
TELEGRAM_WEBHOOK_SECRET=
# O'quvchi ma'lumotini tashqi AI xizmatiga yuborishga rozilik bo'lsa true qiling.
TELEGRAM_AI_ENABLED=false
# At least 16 random characters. Vercel sends it as Authorization: Bearer ... to cron routes.
CRON_SECRET=
LOVABLE_API_KEY=
TELEPHONY_WEBHOOK_SECRET=
SIP_PROVIDER_API_KEY=
FISCAL_API_URL=
FISCAL_API_TOKEN=
FISCAL_CASHBOX_ID=
FISCAL_COMPANY_TIN=
